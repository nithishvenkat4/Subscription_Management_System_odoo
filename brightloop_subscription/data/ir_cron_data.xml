<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Automated Recurring Billing Cron Job -->
        <record id="ir_cron_recurring_billing" model="ir.cron">
            <field name="name">Brightloop: Automated Recurring Billing Run</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_recurring_billing()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
