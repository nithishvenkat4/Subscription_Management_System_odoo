<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_brightloop" model="ir.ui.view">
        <field name="name">product.template.form.inherit.brightloop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_subscription_product"/>
                    <label for="is_subscription_product"/>
                </span>
            </xpath>
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Brightloop Subscription Variant Settings" invisible="not is_subscription_product">
                    <group>
                        <field name="brand_variant_surcharge"/>
                        <field name="cost_price"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
