<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Tree View -->
    <record id="view_brightloop_subscription_tree" model="ir.ui.view">
        <field name="name">brightloop.subscription.tree</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions" decoration-info="state == 'draft'" decoration-warning="state == 'paused'" decoration-success="state == 'active'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="next_billing_date"/>
                <field name="amount_total" sum="Total Recurring"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state in ('draft', 'quotation')" decoration-warning="state == 'paused'" decoration-danger="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="view_brightloop_subscription_form" model="ir.ui.view">
        <field name="name">brightloop.subscription.form</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_send_quotation" string="Send Quotation" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm Order" type="object" class="oe_highlight" invisible="state != 'quotation'"/>
                    <button name="action_activate" string="Activate Subscription" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_generate_invoice" string="Run Billing (Generate Invoice)" type="object" class="oe_highlight" invisible="state != 'active'"/>
                    <button name="action_pause" string="Pause Subscription" type="object" invisible="state != 'active' or not pausable"/>
                    <button name="action_resume" string="Resume Subscription" type="object" class="oe_highlight" invisible="state != 'paused'"/>
                    <button name="action_renew" string="Renew Contract" type="object" invisible="state not in ('active', 'closed') or not renewable"/>
                    <button name="action_close" string="Close Subscription" type="object" invisible="state not in ('draft', 'quotation', 'confirmed', 'active', 'paused')"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_generate_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Customer &amp; Terms">
                            <field name="partner_id" widget="res_partner_many2one" context="{'res_partner_search_mode': 'customer'}"/>
                            <field name="payment_term_id"/>
                            <field name="applied_discount_id"/>
                        </group>
                        <group string="Plan &amp; Schedule">
                            <field name="plan_id"/>
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="next_billing_date"/>
                            <field name="quote_valid_until" invisible="state not in ('draft', 'quotation')"/>
                        </group>
                    </group>

                    <group string="Plan Policies (Inherited)">
                        <group>
                            <field name="auto_close_on_end" readonly="1"/>
                            <field name="closable_early" readonly="1"/>
                        </group>
                        <group>
                            <field name="pausable" readonly="1"/>
                            <field name="renewable" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Recurring Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                    <field name="price_tax"/>
                                    <field name="price_total"/>
                                </tree>
                            </field>

                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_discount" invisible="amount_discount == 0"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Invoices History">
                            <field name="invoice_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Subscription Kanban View -->
    <record id="view_brightloop_subscription_kanban" model="ir.ui.view">
        <field name="name">brightloop.subscription.kanban</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_dashboard">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="amount_total"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted"><field name="partner_id"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><span class="badge badge-primary"><field name="plan_id"/></span></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="next_billing_date"/>
                                </div>
                                <div class="oe_kanban_bottom_right font-weight-bold">
                                    $<field name="amount_total"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_brightloop_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription!
            </p>
        </field>
    </record>
</odoo>
